# Photon Spectrum (app.photon.codes -> project Settings). Leave blank to run in terminal mode.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# More bots, one per Photon project (e.g. a friend's project with their number linked). Each person texts
# their own bot 1:1; group orders span bots. Format: label=<project id>:<project secret>, comma-separated.
SPECTRUM_EXTRA_PROJECTS=
# terminal | imessage | both   (default: imessage if creds set, else terminal)
MODE=

# Gemini (aistudio.google.com/apikey) runs the agent.
# comma-separate several teammates' keys to multiply the free-tier rate limit
GEMINI_API_KEYS=

# Optional: Claude (console.anthropic.com). When set, the agent uses Claude Haiku 4.5 instead of Gemini.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Optional — mock data/links are used when blank
SERPAPI_KEY=
# Capital One Nessie (nessieisreal.com -> sign in -> API key). Blank = simulated payments
NESSIE_API_KEY=
PORT=3077
BOT_NAME=cart
