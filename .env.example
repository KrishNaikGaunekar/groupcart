# Photon Spectrum (app.photon.codes -> project Settings). Leave blank to run in terminal mode.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# terminal | imessage | both   (default: imessage if creds set, else terminal)
MODE=

# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional — mock data/links are used when blank
SERPAPI_KEY=
# Capital One Nessie (nessieisreal.com -> sign in -> API key). Blank = simulated payments
NESSIE_API_KEY=
PORT=3000
BOT_NAME=cart
