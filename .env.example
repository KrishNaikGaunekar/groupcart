# Copy to .env and fill in. .env is gitignored; never commit keys.
# After changing it, re-run scripts/setup.sh so the runtime picks the values up.

# Photon Spectrum (app.photon.codes -> project -> Settings)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini (aistudio.google.com/apikey). Comma-separate several teammates' keys:
# free-tier quota is about 20 requests a day PER MODEL PER KEY, and one dinner split is ~30 requests.
GEMINI_API_KEYS=

# Capital One Nessie (nessieisreal.com -> sign in -> API key). Blank = simulated bank.
NESSIE_API_KEY=

# The website's signup endpoint (app/split/signup.py), served by the gateway. Leave the port
# blank to keep it off. Nobody can sign up without the invite code; blank = signups closed.
GROUPCART_SIGNUP_PORT=
GROUPCART_INVITE_CODE=

# --- only used by the original TypeScript bot in app/spectrum-bot ---
# terminal | imessage | both   (default: imessage if Spectrum creds are set, else terminal)
MODE=
SERPAPI_KEY=
PORT=3077
BOT_NAME=cart
